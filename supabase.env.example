# Supabase connection (choose one method)

# Method 1: single connection string (from Supabase -> Connect -> URI, convert to Npgsql format)
# CLINICCORE_CONNECTION_STRING=Host=db.xxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Method 2: separate variables (used by run-supabase.example.bat)
CLINICCORE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
CLINICCORE_DB_PORT=5432
CLINICCORE_DB_NAME=postgres
CLINICCORE_DB_USER=postgres
CLINICCORE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
