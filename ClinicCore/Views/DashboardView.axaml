<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicCore.Views.DashboardView">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="24">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="Welcome to ClinicCore Hospital Records System" Foreground="#6B7280" FontSize="14"/>

            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Patients" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Name="TxtPatients" Text="..." FontSize="36" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text="Total registered" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Doctors" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Name="TxtDoctors" Text="..." FontSize="36" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Total registered" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Appointments" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Name="TxtAppointments" Text="..." FontSize="36" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="Total scheduled" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="White" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Prescriptions" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Name="TxtPrescriptions" Text="..." FontSize="36" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="Total issued" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Info Box -->
            <Border Background="White" CornerRadius="12" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="System Info" FontSize="16" FontWeight="SemiBold" Foreground="Black"/>
                    <TextBlock Name="TxtInfo" Text="Loading..." Foreground="#374151" FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>