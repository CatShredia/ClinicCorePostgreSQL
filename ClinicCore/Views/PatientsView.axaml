<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ClinicCore.Models"
             x:Class="ClinicCore.Views.PatientsView">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="28,24,28,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Name="TxtTitle" Text="Patients" FontSize="24" FontWeight="Bold" Foreground="Black"/>
                    <TextBlock Name="PatientCount" Text="Loading..." Foreground="#374151" FontSize="13"/>
                </StackPanel>
                <Button Name="BtnAdd" Grid.Column="1" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="AddPatient_Click">+ Add Patient</Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Name="FormPanel" IsVisible="False" Background="White" Margin="28,0,28,16" Padding="24" CornerRadius="10">
            <StackPanel>
                <TextBlock Name="FormTitle" Text="Add New Patient" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Name="LblFullName" Text="Full Name"/>
                        <TextBox Name="TxtName" PlaceholderText="Full name" Margin="0,0,0,8"/>
                        <TextBlock Name="LblDOB" Text="Date of Birth"/>
                        <TextBox Name="TxtDOB" PlaceholderText="YYYY-MM-DD" Margin="0,0,0,8"/>
                        <TextBlock Name="LblGender" Text="Gender"/>
                        <ComboBox Name="CmbGender" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Name="LblPhone" Text="Phone"/>
                        <TextBox Name="TxtPhone" PlaceholderText="Phone number" Margin="0,0,0,8"/>
                        <TextBlock Name="LblAddress" Text="Address"/>
                        <TextBox Name="TxtAddress" PlaceholderText="Address" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Name="BtnCancel" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="CancelForm_Click">Cancel</Button>
                    <Button Name="BtnSave" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="SavePatient_Click">Save Patient</Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="28,0,28,0" CornerRadius="10" ClipToBounds="True" Background="White">
            <DockPanel>
                <Grid ColumnDefinitions="60,200,120,90,140,*" Background="#F1F5F9" DockPanel.Dock="Top">
                    <TextBlock Name="ColId" Grid.Column="0" Text="ID" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColFullName" Grid.Column="1" Text="Full Name" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColDOB" Grid.Column="2" Text="DOB" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColGender" Grid.Column="3" Text="Gender" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColPhone" Grid.Column="4" Text="Phone" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColAddress" Grid.Column="5" Text="Address" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                </Grid>
                <ListBox Name="PatientsGrid" Background="White" Foreground="Black">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Patient">
                            <Grid ColumnDefinitions="60,200,120,90,140,*">
                                <TextBlock Grid.Column="0" Text="{Binding PatientID}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding FullName}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="2" Text="{Binding DateOfBirth}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="{Binding Gender}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="4" Text="{Binding Phone}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="5" Text="{Binding Address}" Padding="10,6" FontSize="13" Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Padding="28,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="BtnEdit" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="EditPatient_Click">Edit Selected</Button>
                <Button Name="BtnDelete" Background="#EF4444" Foreground="White" Padding="16,8" CornerRadius="6" Click="DeletePatient_Click">Delete Selected</Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
