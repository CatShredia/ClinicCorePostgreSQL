<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ClinicCore.Models"
             x:Class="ClinicCore.Views.AppointmentsView">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="28,24,28,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Name="TxtTitle" Text="Appointments" FontSize="24" FontWeight="Bold" Foreground="Black"/>
                    <TextBlock Name="ApptCount" Text="Loading..." Foreground="#374151" FontSize="13"/>
                </StackPanel>
                <Button Name="BtnAdd" Grid.Column="1" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="AddAppt_Click">+ Add Appointment</Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Name="FormPanel" IsVisible="False" Background="White" Margin="28,0,28,16" Padding="24" CornerRadius="10">
            <StackPanel>
                <TextBlock Name="FormTitle" Text="Add New Appointment" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Name="LblPatientId" Text="Patient ID"/>
                        <TextBox Name="TxtPatientID" PlaceholderText="Patient ID" Margin="0,0,0,8"/>
                        <TextBlock Name="LblDoctorId" Text="Doctor ID"/>
                        <TextBox Name="TxtDoctorID" PlaceholderText="Doctor ID" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Name="LblDate" Text="Date (YYYY-MM-DD HH:MM)"/>
                        <TextBox Name="TxtDate" PlaceholderText="2025-01-15 10:00" Margin="0,0,0,8"/>
                        <TextBlock Name="LblNotes" Text="Notes"/>
                        <TextBox Name="TxtNotes" PlaceholderText="Optional notes" Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Name="BtnCancel" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="CancelForm_Click">Cancel</Button>
                    <Button Name="BtnSave" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="SaveAppt_Click">Save Appointment</Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="28,0,28,0" CornerRadius="10" ClipToBounds="True" Background="White">
            <DockPanel>
                <Grid ColumnDefinitions="60,100,100,150,120,*" Background="#F1F5F9" DockPanel.Dock="Top">
                    <TextBlock Name="ColId" Grid.Column="0" Text="ID" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColPatientId" Grid.Column="1" Text="Patient ID" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColDoctorId" Grid.Column="2" Text="Doctor ID" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColDate" Grid.Column="3" Text="Date" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColStatus" Grid.Column="4" Text="Status" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColNotes" Grid.Column="5" Text="Notes" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                </Grid>
                <ListBox Name="ApptsGrid" Background="White" Foreground="Black">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Appointment">
                            <Grid ColumnDefinitions="60,100,100,150,120,*">
                                <TextBlock Grid.Column="0" Text="{Binding AppointmentID}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding PatientID}"     Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="2" Text="{Binding DoctorID}"      Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="{Binding AppointmentDate}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="4" Text="{Binding Status}"        Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="5" Text="{Binding Notes}"         Padding="10,6" FontSize="13" Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Padding="28,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="BtnEdit" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="EditAppt_Click">Edit Selected</Button>
                <Button Name="BtnDelete" Background="#EF4444" Foreground="White" Padding="16,8" CornerRadius="6" Click="DeleteAppt_Click">Delete Selected</Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
