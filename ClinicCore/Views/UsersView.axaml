<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ClinicCore.Models"
             x:Class="ClinicCore.Views.UsersView">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="28,24,28,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Name="TxtTitle" Text="Users" FontSize="24" FontWeight="Bold" Foreground="Black"/>
                    <TextBlock Name="UserCount" Text="Loading..." Foreground="#374151" FontSize="13"/>
                </StackPanel>
                <Button Name="BtnAdd" Grid.Column="1" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="AddUser_Click">+ Add User</Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Name="FormPanel" IsVisible="False" Background="White" Margin="28,0,28,16" Padding="24" CornerRadius="10">
            <StackPanel Spacing="12">
                <TextBlock Name="FormTitle" Text="Add New User" FontSize="16" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Name="LblUsername" Text="Username"/>
                        <TextBox Name="TxtUsername" PlaceholderText="username" Margin="0,0,0,8"/>
                        <TextBlock Name="LblPassword" Text="Password"/>
                        <TextBox Name="TxtPassword" PasswordChar="●" PlaceholderText="password" Margin="0,0,0,8"/>
                        <TextBlock Name="LblFullName" Text="Full Name"/>
                        <TextBox Name="TxtFullName" PlaceholderText="Full name" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Name="LblRole" Text="Role"/>
                        <ComboBox Name="CmbRole" HorizontalAlignment="Stretch" Margin="0,0,0,8" SelectionChanged="CmbRole_Changed"/>
                        <CheckBox Name="ChkActive" Content="Active" IsVisible="False" Margin="0,8,0,0"/>
                        <TextBlock Name="LblPasswordHint" Text="" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Background="#F8FAFC" CornerRadius="8" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Name="LblAccessMatrix" Text="Access rights" FontWeight="SemiBold" FontSize="12" Foreground="#374151"/>
                        <TextBlock Name="TxtAccessMatrix" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="BtnCancel" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="CancelForm_Click">Cancel</Button>
                    <Button Name="BtnSave" Background="#3B82F6" Foreground="White" Padding="16,8" CornerRadius="6" Click="SaveUser_Click">Save User</Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="28,0,28,0" CornerRadius="10" ClipToBounds="True" Background="White">
            <DockPanel>
                <Grid ColumnDefinitions="50,120,200,130,80,140" Background="#F1F5F9" DockPanel.Dock="Top">
                    <TextBlock Name="ColId" Grid.Column="0" Text="ID" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColUsername" Grid.Column="1" Text="Username" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColFullName" Grid.Column="2" Text="Full Name" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColRole" Grid.Column="3" Text="Role" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColActive" Grid.Column="4" Text="Active" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                    <TextBlock Name="ColLastLogin" Grid.Column="5" Text="Last Login" FontWeight="Bold" Padding="10,8" FontSize="13" Foreground="Black"/>
                </Grid>
                <ListBox Name="UsersGrid" Background="White" Foreground="Black">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:UserAccount">
                            <Grid ColumnDefinitions="50,120,200,130,80,140">
                                <TextBlock Grid.Column="0" Text="{Binding UserID}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="2" Text="{Binding FullName}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="{Binding RoleName}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="4" Text="{Binding ActiveStatus}" Padding="10,6" FontSize="13" Foreground="Black"/>
                                <TextBlock Grid.Column="5" Text="{Binding LastLoginAt}" Padding="10,6" FontSize="13" Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Padding="28,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="BtnEdit" Background="#6B7280" Foreground="White" Padding="16,8" CornerRadius="6" Click="EditUser_Click">Edit Selected</Button>
                <Button Name="BtnDelete" Background="#EF4444" Foreground="White" Padding="16,8" CornerRadius="6" Click="DeleteUser_Click">Delete Selected</Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
